# Canonical source:
# https://github.com/dejwk/roo_testing/blob/main/.roo_testing/bazelrc/esp32s3/idf.bazelrc
#
# ESP-IDF-only frontend for the shared ESP32S3 base. Import base.bazelrc
# before this file. No Arduino frontend, board, variant, or USB macros are added.
build:roo_testing_idf_esp32s3 --config=roo_testing_esp32s3_base
build:roo_testing_idf_esp32s3 --platforms=@roo_testing//roo_testing/platforms:idf_esp32s3
